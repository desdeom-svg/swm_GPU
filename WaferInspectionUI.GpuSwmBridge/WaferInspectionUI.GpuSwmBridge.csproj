<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>WaferInspectionUI.GpuSwmBridge</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BridgeSharedSource>D:\Projects\opencvProject\WaferInspectionPatternCpu\swm\WaferInspectionUI.SwmBridge</BridgeSharedSource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(BridgeSharedSource)\BridgeInspectionPolicy.cs" Link="BridgeInspectionPolicy.cs" />
    <Compile Include="GpuBridgeRequest.cs" />
    <Compile Include="GpuRecipeAdapter.cs" />
    <Compile Include="GpuRecipeInputLoader.cs" />
    <Compile Include="BridgeResponseWriter.cs" />
    <Compile Include="OfflineImageLayout.cs" />
    <Compile Include="$(BridgeSharedSource)\OfflineLayoutCompatibility.cs" Link="OfflineLayoutCompatibility.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWM.csproj" />
    <Reference Include="AutoReviewSystem.Data">
      <HintPath>..\bin\Debug\AutoReviewSystem.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
